  },
  "dependencies": {
    "@dmfaster/local-auth": "0.1.1",
    "@dmfaster/sdk": "0.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
