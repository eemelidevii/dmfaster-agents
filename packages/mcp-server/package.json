{
  "name": "@dmfaster/mcp-server",
  "version": "1.0.0",
  "description": "Stateless DM Faster Agent 1.0 MCP server with a portable interactive campaign workspace.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eemelidevii/dmfaster-agents.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "dmfaster-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:ui": "node tools/build-campaign-workspace-ui.mjs",
    "build": "npm run generate:ui && tsc -p tsconfig.json",
    "typecheck": "npm run generate:ui && tsc -p ui/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "npm run generate:ui && node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dmfaster/local-auth": "1.0.0",
    "@dmfaster/sdk": "1.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dmfaster/product-ui": "0.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
