{
  "name": "@dmfaster/mcp-server",
  "version": "0.1.1",
  "description": "Read-only stdio MCP server for DM Faster.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eemelidevii/dmfaster-agents.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "dmfaster-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
