{
  "name": "@dmfaster/sdk",
  "version": "1.0.0",
  "description": "Typed client for the DM Faster Agent API.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eemelidevii/dmfaster-agents.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
